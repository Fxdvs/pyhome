**/__pycache__/

# runtime state, the server writes this next to whatever config it was started with
server/**/clients.json
server/**/clients.json.imported

# the server's database, its WAL files and the copies data backup makes
server/**/pyhome.db*
server/**/pyhome-backup-*.db

# real configs hold the token; only the examples they are made from are in git
server/data/config.json
client/data/*.json
!client/data/*.example.json

# what the launcher remembers between starts
launcher/state.json

# keys must never be committed, and a house's ca.crt is not the project's
**/certs/

# pytest
.pytest_cache/
